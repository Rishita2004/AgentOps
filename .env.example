# PostgreSQL (required). Owner role used for schema, seeding and approved decisions.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/commerce
# Read-only role the agents query through (created on startup from AGENT_DB_PASSWORD).
AGENT_DB_PASSWORD=
AGENT_DB_URL=postgresql+psycopg://agent_ro:SAME_PASSWORD@127.0.0.1:5432/commerce

# Optional: Gemini drives the agents' tool use. Without it a local policy runs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Operator sign-in. Use long random values (at least 12 and 32 characters).
SELLER_ACCESS_CODE=
SESSION_SECRET=

ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ENABLE_DOCS=0
MAX_RUNS_PER_HOUR=20
